# Agent configuration
# Columns: <agent_name>  <skills_path>  <instruction_symlink>  <mcp_config_path>
#
#   skills_path        — where skill symlinks are deployed
#   instruction_symlink — ABSOLUTE path (~ expanded) where the agent reads its
#                         global instruction file.
#   mcp_config_path    — ABSOLUTE path (~ expanded) where MCP servers JSON config is synced.

claude   ~/.claude/skills   ~/.claude/CLAUDE.md   ~/.config/Claude/claude_desktop_config.json
codex    ~/.codex/skills    ~/AGENTS.md           ~/.codex/mcp.json
gemini   ~/.gemini/skills   ~/.gemini/GEMINI.md   ~/.gemini/mcp.json
cursor   ~/.cursor/rules    -                     ~/.cursor/mcp.json
copilot  ~/.copilot/skills  -                     -

